; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="FPVR"
config/icon="res://icon.svg"
run/main_scene="res://bootstrap.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[autoload]

Settings="*res://core_services/settings.gd"
HardwareHub="*res://core_services/hardware_hub.gd"
DetectionService="*res://core_services/detection_service.gd"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/environment_blend_mode=2
